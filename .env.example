# Required
RESEND_API_KEY=re_xxxxxxxx
MAIL_DOMAIN=mail.example.com
ADMIN_RECOVERY_EMAIL=admin@example.com

# Generated at deploy (template uses ${{secret(...)}})
SECRET_KEY=
APP_ENCRYPTION_KEY=
BOOTSTRAP_TOKEN=

# Public URL (default: https://$RAILWAY_PUBLIC_DOMAIN when set)
PUBLIC_URL=http://localhost:8000
# Optional extra CSRF trusted origins (comma-separated); Railway *.up.railway.app is added automatically
# CSRF_TRUSTED_ORIGINS=

# Optional Postgres (omit for SQLite on /data)
# DATABASE_URL=postgres://user:pass@localhost:5432/mailstead

# Data paths (defaults work in Docker / Railway)
# DATA_ROOT=/data
# RAILWAY_PUBLIC_DOMAIN=

# Worker / ops
# WORKER_HEARTBEAT_MAX_AGE_SECONDS=120
