# Required
RESEND_API_KEY=re_xxxxxxxx
MAIL_DOMAIN=mail.example.com
ADMIN_RECOVERY_EMAIL=admin@example.com

# Generated at deploy (template uses ${{secret(...)}})
SECRET_KEY=
APP_ENCRYPTION_KEY=
BOOTSTRAP_TOKEN=

# Public URL (default: https://$RAILWAY_PUBLIC_DOMAIN when set)
PUBLIC_URL=http://localhost:8000

# Optional Postgres (omit for SQLite on /data)
# DATABASE_URL=postgres://user:pass@localhost:5432/mailstead

# Data paths (defaults work in Docker / Railway)
# DATA_ROOT=/data
# RAILWAY_PUBLIC_DOMAIN=

# Worker / ops
# WORKER_HEARTBEAT_MAX_AGE_SECONDS=120

# Web Push (generate once: `uv run vapid --gen` then `uv run vapid --applicationServerKey -k private_key.pem`)
# VAPID_PUBLIC_KEY=   # applicationServerKey (base64url)
# VAPID_PRIVATE_KEY=  # contents of private_key.pem (or DER base64 from that file)
# PUSH_DEBOUNCE_SECONDS=45

# Native app push (Expo). Leave empty to keep phone push disabled; web push is unchanged.
# EXPO_ACCESS_TOKEN=
