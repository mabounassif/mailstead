---
import Base from "../layouts/Base.astro";
---

<Base
  title="Page not found"
  description="That page is not on the Mailstead marketing site."
  path="/404/"
  noindex={true}
>
  <section class="section">
    <div class="wrap prose">
      <h1>That page is not here</h1>
      <p>The marketing site has a home page, pricing, comparisons, and guides. Mailbox URLs belong on your own deployed instance, not on mailstead.app.</p>
      <p>
        <a href="/">Home</a> · <a href="/guides/">Guides</a> · <a href="/pricing/">Pricing</a>
      </p>
    </div>
  </section>
</Base>
